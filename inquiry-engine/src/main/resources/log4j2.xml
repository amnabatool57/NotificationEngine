<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configuration SYSTEM "log4j2.dtd">
<Configuration>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%style{%d{ISO8601}}{bright,green} %highlight{%-5level }[%style{%t}{bright,blue}] %style{%C{1.}}{bright,yellow}: %msg%n%throwable" />
		</Console>
		<RollingFile name="RollingFile"
			fileName="C:\\logs\\InquiryEngine\\app.log"
			filePattern="C:\\logs\\$${date:yyyy-MM}\\spring-boot-logger-log4j2-%d{-dd-MMMM-yyyy}-%i.log.gz">
			<PatternLayout
				pattern="{%d{ISO8601}} {%-5level} {%t} {%C{1.} } : %msg%n%throwable" />
			<Policies>
				<OnStartupTriggeringPolicy />
				<SizeBasedTriggeringPolicy
					size="10 MB" />
				<TimeBasedTriggeringPolicy />
			</Policies>
		</RollingFile>
	</Appenders>

	<Loggers>
		<Root level="info">
			<AppenderRef ref="Console" />
			<AppenderRef ref="RollingFile" />
		</Root>

		<Logger name="com.techlogix" level="trace"></Logger>
	</Loggers>

</Configuration>
